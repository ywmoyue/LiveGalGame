<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiveGalGameWAS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiveGalGameWAS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="LiveGalGameWAS">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- 背景图片 -->
        <!--<Image x:Name="BackgroundImage" Stretch="UniformToFill" Source="ms-appx:///Assets/StoreLogo.png"/>-->
        
        <!-- 视频背景 -->
        <Image x:Name="VideoBackground" Stretch="UniformToFill" Visibility="Collapsed"/>

        <controls:CameraPreview x:Name="CameraPreviewControl"
                                Visibility="Collapsed"
                                IsFrameSourceGroupButtonVisible="True" />


        <!-- 字幕区域 -->
        <Border x:Name="SubtitleBorder" 
                Background="#AA000000" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,50,0,0" 
                Padding="20,10" 
                CornerRadius="10"
                Visibility="Collapsed">
            <TextBlock x:Name="SubtitleText" 
                      Text="字幕显示区域" 
                      Foreground="White" 
                      FontSize="16" 
                      TextWrapping="Wrap" 
                      TextAlignment="Center" 
                      MaxWidth="600"/>
        </Border>
        
        <!-- 对话框 -->
        <Border x:Name="DialogBorder" 
                Background="#CC000000" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Margin="0,0,0,100" 
                Padding="20,15" 
                CornerRadius="15"
                Width="600"
                Height="150">
            <StackPanel>
                <!-- 说话者名称 -->
                <TextBlock x:Name="SpeakerText" 
                          Text="说话者" 
                          Foreground="#FFD700" 
                          FontSize="18" 
                          FontWeight="Bold" 
                          Margin="0,0,0,10"/>
                
                <!-- 对话内容 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="80">
                    <TextBlock x:Name="DialogText" 
                              Text="这里是对话内容..." 
                              Foreground="White" 
                              FontSize="16" 
                              TextWrapping="Wrap"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
        
        <!-- 选项按钮区域 -->
        <StackPanel x:Name="OptionsPanel" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Bottom" 
                   Margin="0,0,0,20" 
                   Spacing="10"
                   Visibility="Collapsed">
            <Button x:Name="Option1Button" 
                   Content="选项1" 
                   Background="#4CAF50" 
                   Foreground="White" 
                   Padding="20,10" 
                   FontSize="14"
                   Click="OptionButton_Click"/>
            <Button x:Name="Option2Button" 
                   Content="选项2" 
                   Background="#2196F3" 
                   Foreground="White" 
                   Padding="20,10" 
                   FontSize="14"
                   Click="OptionButton_Click"/>
            <Button x:Name="Option3Button" 
                   Content="选项3" 
                   Background="#FF9800" 
                   Foreground="White" 
                   Padding="20,10" 
                   FontSize="14"
                   Click="OptionButton_Click"/>
        </StackPanel>
        
        <!-- 背景控制按钮 -->
        <Button x:Name="BackgroundSettingsButton" 
                Content="⚙️" 
                Background="Transparent" 
                Foreground="White" 
                FontSize="16" 
                Width="40" 
                Height="40" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="20,20,0,0" 
                Click="BackgroundSettingsButton_Click"/>
        
        <!-- 背景设置面板 -->
        <Border x:Name="BackgroundSettingsPanel" 
                Background="#CC000000" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="20,70,0,0" 
                Padding="15" 
                CornerRadius="10"
                Visibility="Collapsed"
                Width="300">
            <StackPanel Spacing="10">
                <TextBlock Text="背景设置" Foreground="White" FontSize="16" FontWeight="Bold"/>
                
                <ComboBox x:Name="BackgroundTypeComboBox" 
                         Header="背景类型:" 
                         SelectionChanged="BackgroundTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="静态图片" IsSelected="True"/>
                    <ComboBoxItem Content="相机视频流"/>
                    <ComboBoxItem Content="应用程序画面"/>
                </ComboBox>
                
                <ComboBox x:Name="CameraDeviceComboBox" 
                         Header="选择相机:" 
                         Visibility="Collapsed"/>
                
                <ComboBox x:Name="ApplicationComboBox" 
                         Header="选择应用程序:" 
                         Visibility="Collapsed"/>
                
                <Button x:Name="StartCaptureButton" 
                       Content="开始捕获" 
                       Click="StartCaptureButton_Click" 
                       Background="#4CAF50" 
                       Foreground="White"/>
                
                <Button x:Name="StopCaptureButton" 
                       Content="停止捕获" 
                       Click="StopCaptureButton_Click" 
                       Background="#F44336" 
                       Foreground="White"
                       Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        
        <!-- 语音识别状态 -->
        <Border x:Name="SpeechStatusBorder" 
                Background="#AA000000" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,20,20,0" 
                Padding="15,8" 
                CornerRadius="20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse x:Name="SpeechIndicator" 
                        Width="12" 
                        Height="12" 
                        Fill="Red"/>
                <TextBlock x:Name="SpeechStatusText" 
                          Text="语音识别未启动" 
                          Foreground="White" 
                          FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
