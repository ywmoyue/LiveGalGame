<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LiveGalGameWAS.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" MaxWidth="600">
                <!-- 页面标题 -->
                <TextBlock Text="应用设置" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource ApplicationForegroundThemeBrush}"/>
                
                <!-- 语音识别设置 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="15">
                    <StackPanel Spacing="12">
                        <TextBlock Text="语音识别设置" FontSize="18" FontWeight="SemiBold"/>
                        
                        <!-- 语音识别方式 -->
                        <ComboBox x:Name="SpeechRecognitionTypeComboBox" 
                                 Header="语音识别方式:" 
                                 SelectionChanged="SpeechRecognitionTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Windows语音识别" Tag="WindowsSpeech"/>
                            <ComboBoxItem Content="VOSK离线识别" Tag="Vosk"/>
                        </ComboBox>
                        
                        <!-- 麦克风设备选择 -->
                        <StackPanel x:Name="MicrophoneSettingsPanel" Spacing="8">
                            <TextBlock Text="选择麦克风设备:" FontWeight="SemiBold"/>
                            <ComboBox x:Name="MicrophoneDeviceComboBox" 
                                     PlaceholderText="请选择麦克风设备"
                                     SelectionChanged="MicrophoneDeviceComboBox_SelectionChanged"/>
                            <Button x:Name="RefreshMicrophoneListButton" 
                                   Content="刷新麦克风列表" 
                                   Click="RefreshMicrophoneListButton_Click"
                                   HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <!-- VOSK模型路径设置 -->
                        <StackPanel x:Name="VoskSettingsPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="VOSK模型路径:" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox x:Name="VoskModelPathTextBox" 
                                        Grid.Column="0" 
                                        PlaceholderText="请选择VOSK模型文件夹路径"
                                        IsReadOnly="True"/>
                                <Button x:Name="BrowseVoskModelButton" 
                                       Grid.Column="1" 
                                       Content="浏览..." 
                                       Margin="8,0,0,0"
                                       Click="BrowseVoskModelButton_Click"/>
                            </Grid>
                            <TextBlock Text="请选择包含VOSK模型的文件夹" 
                                      FontSize="12" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- 背景设置 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="15">
                    <StackPanel Spacing="12">
                        <TextBlock Text="背景显示设置" FontSize="18" FontWeight="SemiBold"/>
                        
                        <!-- 背景类型 -->
                        <ComboBox x:Name="BackgroundTypeComboBox" 
                                 Header="背景类型:" 
                                 SelectionChanged="BackgroundTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="静态图片" Tag="StaticImage"/>
                            <ComboBoxItem Content="相机视频流" Tag="Camera"/>
                            <ComboBoxItem Content="应用程序画面" Tag="Application"/>
                        </ComboBox>
                        
                        <!-- 相机设备选择 -->
                        <StackPanel x:Name="CameraSettingsPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="选择相机设备:" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CameraDeviceComboBox" 
                                     PlaceholderText="请选择相机设备"
                                     SelectionChanged="CameraDeviceComboBox_SelectionChanged"/>
                            <Button x:Name="RefreshCameraListButton" 
                                   Content="刷新相机列表" 
                                   Click="RefreshCameraListButton_Click"
                                   HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <!-- 应用程序选择 -->
                        <StackPanel x:Name="ApplicationSettingsPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="选择应用程序:" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ApplicationComboBox" 
                                     PlaceholderText="请选择应用程序"/>
                        </StackPanel>
                        

                    </StackPanel>
                </Border>
                
                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" 
                           Content="保存设置" 
                           Click="SaveButton_Click"
                           Background="{ThemeResource AccentFillColorDefaultBrush}"
                           Foreground="White"/>
                    <Button x:Name="CancelButton" 
                           Content="取消" 
                           Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>